---
import { Picture, getImage } from 'astro:assets';
import Icon from './Icon.astro';
import type { ImageMetadata } from 'astro';
import content from '../data/content.json';

const images = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/projects/**/*.{png,jpg,jpeg}', { eager: true },
);
const load = (file: string) => {
  const img = images[`../assets/projects/${file}`]?.default;
  if (!img) throw new Error(`Project image not found: src/assets/projects/${file}`);
  return img;
};
const projects = await Promise.all(content.projects.map(async (p) => {
  const imgs = await Promise.all(p.images.map(async (i) => {
    const src = load(i.file);
    // Largest variant for the lightbox.
    const full = await getImage({ src, width: Math.min(2400, src.width), format: 'webp' });
    return { ...i, src, full: full.src };
  }));
  return { ...p, images: imgs };
}));
---
<section id="portfolio" class="section">
  <div class="container">
    <div class="section-head">
      <span class="eyebrow">Portfoolio</span>
      <h2 class="section-title">Viimased projektid</h2>
    </div>

    <div class="list">
      {projects.map((p, n) => (
        <article class:list={['card', 'project', { flip: n % 2 }]} id={`projekt-${p.slug}`}>
          <div class="text">
            <span class="eyebrow">{p.year} · {p.status}</span>
            <h3>{p.name}</h3>
            <p class="lead">{p.description}</p>
            <p class="role"><strong>Roll:</strong> {p.role}</p>
            <details>
              <summary>Mida tegin</summary>
              <p>{p.text}</p>
              {'roleItems' in p && p.roleItems && (
                <ul>{p.roleItems.map((i) => <li>{i}</li>)}</ul>
              )}
            </details>
            {p.tech && <p class="tech"><strong>Tehnoloogiad:</strong> {p.tech}</p>}
            {p.url && (
              <a class="btn btn-primary" href={p.url} target="_blank" rel="noopener noreferrer">
                Ava {p.url.replace(/^https?:\/\//, '')}<span class="sr-only"> (avaneb uues aknas)</span>
              </a>
            )}
          </div>

          <div class="gallery" data-gallery
            data-images={JSON.stringify(p.images.map((img) => ({
              src: img.full, alt: `${p.name}: ${img.caption}`, caption: `${p.name} · ${img.caption}`,
            })))}>
            <div class="main">
              {p.images.map((img, i) => (
                <figure hidden={i !== 0} data-slide>
                  <button type="button" class="zoom" data-zoom={i} aria-label={`Suurenda pilti: ${img.caption}`}>
                    <Picture src={img.src} alt={`${p.name}: ${img.caption}`} formats={['avif', 'webp']}
                      widths={[600, 1200, 2400]} sizes="(max-width: 1023px) 100vw, 640px" loading="lazy" />
                    <span class="zoom-hint" aria-hidden="true"><Icon name="zoom" size={20} /></span>
                  </button>
                  <figcaption>{img.caption}</figcaption>
                </figure>
              ))}
            </div>
            {p.images.length > 1 && (
              <div class="thumbs" role="group" aria-label={`${p.name} pildid`}>
                {p.images.map((img, i) => (
                  <button type="button" data-thumb={i} aria-pressed={i === 0 ? 'true' : 'false'}
                    aria-label={`Näita pilti: ${img.caption}`}>
                    <Picture src={img.src} alt="" formats={['webp']} widths={[240]} sizes="120px" loading="lazy" />
                  </button>
                ))}
              </div>
            )}
          </div>
        </article>
      ))}
    </div>

    <h3 class="more-title">Muud projektid</h3>
    <div class="more">
      {content.moreProjects.map((m) => (
        <article class="card mini">
          <span class="eyebrow">{m.status}</span>
          <h4>{m.name}</h4>
          <p class="sub">{m.subtitle}</p>
          <p>{m.description}</p>
          <ul class="chips">{m.features.map((f) => <li>{f}</li>)}</ul>
          <p class="extra">{m.extra}</p>
          <details>
            <summary>Minu roll</summary>
            <ul>{m.roleItems.map((i) => <li>{i}</li>)}</ul>
          </details>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .list { display: grid; gap: 40px; }
  .project {
    display: grid;
    grid-template-columns: 1fr 1.5fr;
    gap: 48px;
    align-items: start;
    padding: 48px;
  }
  .project > * { min-width: 0; }
  .project.flip .text { order: 2; }
  h3 { font-size: 24px; font-weight: 700; margin-bottom: 12px; }
  p { margin: 0 0 12px; }
  .lead { color: var(--heading); font-size: 15px; }
  strong { color: var(--heading); font-weight: 600; }
  details { margin: 0 0 12px; }
  summary {
    cursor: pointer;
    color: var(--accent);
    font-weight: 600;
    margin-bottom: 8px;
    width: fit-content;
  }
  details p { margin-top: 4px; }
  .tech { font-size: 13px; margin-bottom: 24px; }
  .btn { margin-top: 4px; }

  .main figure { margin: 0; }
  .main figure:not([hidden]) { animation: fade-in 0.4s ease; }
  @keyframes fade-in { from { opacity: 0; transform: scale(0.985); } to { opacity: 1; transform: none; } }
  .zoom {
    position: relative;
    display: block;
    width: 100%;
    padding: 0;
    border: 0;
    background: none;
    cursor: zoom-in;
    border-radius: var(--radius);
  }
  .zoom :global(img) { transition: transform 0.4s ease, box-shadow 0.4s ease; }
  .zoom:hover :global(img) { transform: translateY(-4px); box-shadow: 0 28px 60px rgba(27, 31, 59, 0.22); }
  .zoom-hint {
    position: absolute;
    right: 14px; bottom: 14px;
    width: 40px; height: 40px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.92);
    color: var(--heading);
    display: grid; place-items: center;
    box-shadow: var(--shadow);
    opacity: 0;
    transform: scale(0.8);
    transition: opacity 0.25s, transform 0.25s;
  }
  .zoom:hover .zoom-hint, .zoom:focus-visible .zoom-hint { opacity: 1; transform: none; }
  @media (hover: none) { .zoom-hint { opacity: 1; transform: none; } }
  .main :global(img) {
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    border-radius: var(--radius);
    box-shadow: 0 20px 50px rgba(27, 31, 59, 0.15);
  }
  figcaption { font-size: 12px; margin-top: 12px; text-align: center; }
  .thumbs {
    display: flex;
    gap: 10px;
    margin-top: 12px;
    overflow-x: auto;
    padding: 4px;
  }
  .thumbs button {
    flex: 0 0 96px;
    padding: 0;
    border: 2px solid transparent;
    border-radius: 6px;
    background: none;
    cursor: pointer;
    opacity: 0.6;
    transition: opacity 0.2s, border-color 0.2s;
  }
  .thumbs button:hover { opacity: 1; transform: translateY(-2px); }
  .thumbs button { transition: opacity 0.2s, border-color 0.2s, transform 0.2s; }
  .thumbs button[aria-pressed='true'] { opacity: 1; border-color: var(--accent); }
  .thumbs :global(img) { width: 100%; aspect-ratio: 16 / 10; object-fit: cover; border-radius: 4px; }

  details ul { margin: 0 0 8px; padding-left: 18px; }
  details li::marker { color: var(--accent); }

  .more-title { text-align: center; font-size: 18px; margin: 64px 0 24px; }
  .more { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; }
  .mini { padding: 28px; display: flex; flex-direction: column; }
  .mini h4 { color: var(--heading); font-size: 18px; margin: 0; }
  .mini .sub { color: var(--heading); font-weight: 500; margin-bottom: 8px; }
  .chips { list-style: none; margin: 4px 0 12px; padding: 0; display: flex; flex-wrap: wrap; gap: 6px; }
  .chips li { background: var(--bg); color: var(--heading); border-radius: 999px; padding: 2px 10px; font-size: 12px; }
  .extra { font-size: 12px; }
  .mini details { margin-top: auto; }

  @media (max-width: 1023px) {
    .more { grid-template-columns: 1fr; }
    .project { grid-template-columns: 1fr; padding: 32px 24px; gap: 28px; }
    .project.flip .text { order: 0; }
  }
</style>

<script>
  for (const g of document.querySelectorAll<HTMLElement>('[data-gallery]')) {
    const slides = g.querySelectorAll<HTMLElement>('[data-slide]');
    const thumbs = g.querySelectorAll<HTMLButtonElement>('[data-thumb]');
    thumbs.forEach((t, i) => t.addEventListener('click', () => {
      slides.forEach((s, j) => (s.hidden = i !== j));
      thumbs.forEach((b, j) => b.setAttribute('aria-pressed', String(i === j)));
    }));
    const images = JSON.parse(g.dataset.images!);
    g.querySelectorAll<HTMLButtonElement>('[data-zoom]').forEach((b) =>
      b.addEventListener('click', () => window.openLightbox?.(images, Number(b.dataset.zoom), b)));
  }
</script>
