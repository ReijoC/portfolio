---
import Icon from './Icon.astro';
import content from '../data/content.json';
interface Props { vertical?: boolean }
const { vertical = false } = Astro.props;
---
<ul class:list={['social', { vertical }]}>
  {content.social.map((s) => (
    <li>
      <a href={s.url} target="_blank" rel="noopener noreferrer">
        <Icon name={s.icon} />
        <span class="sr-only">{s.name} (avaneb uues aknas)</span>
      </a>
    </li>
  ))}
</ul>

<style>
  .social {
    display: inline-flex;
    gap: 10px;
    list-style: none;
    margin: 0;
    padding: 8px 12px;
    background: var(--surface);
    border-radius: 999px;
    box-shadow: var(--shadow);
  }
  .social.vertical { flex-direction: column; padding: 12px 8px; }
  a { display: block; border-radius: 50%; transition: transform 0.2s; }
  a:hover { transform: scale(1.12); }
  :global(.social svg) { display: block; }
</style>
