---
import content from '../data/content.json';
const { skills } = content;

// Points along a rising curve, in percent of the stage (x: left→right, y: top→bottom).
const curveY = (t: number) => 88 - 72 * Math.sign(t) * Math.pow(Math.abs(t), 1.6);
const points = skills.map((_, i) => {
  const t = skills.length > 1 ? i / (skills.length - 1) : 0;
  return { x: 6 + t * 82, y: curveY(t) };
});
const path = Array.from({ length: 41 }, (_, i) => {
  const t = i / 40;
  return `${i ? 'L' : 'M'}${(2 + t * 92).toFixed(2)} ${curveY(t * 1.05 - 0.02).toFixed(2)}`;
}).join(' ');
const end = { x: 94, y: curveY(1.03) };
const first = skills[0];
---
<section id="skills" class="section">
  <div class="container">
    <div class="section-head">
      <span class="eyebrow">Tehnilised oskused</span>
      <h2 class="section-title">Tööriistad ja meetodid</h2>
    </div>

    <div class="stage" data-skills={JSON.stringify(skills)}>
      <svg class="curve" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
        <path d={path} fill="none" stroke="#d4d6e8" stroke-width="2"
          vector-effect="non-scaling-stroke" />
      </svg>
      <span class="arrow" style={`left:${end.x}%;top:${end.y}%`} aria-hidden="true"></span>

      <div class="card skill-card" aria-live="polite">
        <h3 data-field="name">{first.name}</h3>
        <ul class="chips" data-field="items">
          {first.items.map((it, i) => <li style={`--i:${i}`}>{it}</li>)}
        </ul>
        <p class="note" data-field="note" hidden={!first.note}>{first.note}</p>
      </div>

      <ul class="skill-list" role="list">
        {skills.map((s, i) => (
          <li style={`left:${points[i].x}%;top:${points[i].y}%;--i:${i}`}>
            <button type="button" class={`skill tone-${s.tone}`} data-index={i}
              aria-pressed={i === 0 ? 'true' : 'false'} aria-label={s.name}>
              {s.short}
            </button>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

<style>
  .stage { position: relative; height: 420px; }
  .curve { position: absolute; inset: 0; width: 100%; height: 100%; }
  .curve, .arrow { clip-path: inset(-10% 0 -10% 0); transition: clip-path 1.4s var(--ease-out) 0.1s; }
  .skill-list li { transition: opacity 0.5s var(--ease-out), scale 0.5s var(--ease-out); transition-delay: calc(0.25s + var(--i) * 90ms); }
  :global(.js) .stage:not(.is-visible) .curve { clip-path: inset(-10% 100% -10% 0); }
  :global(.js) .stage:not(.is-visible) .arrow { clip-path: inset(0 100% 0 0); }
  :global(.js) .stage:not(.is-visible) .skill-list li { opacity: 0; scale: 0.6; }
  .chips :global(li) { animation: chip-in 0.35s var(--ease-out) both; animation-delay: calc(var(--i, 0) * 22ms); }
  @keyframes chip-in { from { opacity: 0; translate: 0 6px; } }
  .arrow {
    position: absolute;
    width: 0; height: 0;
    border-left: 12px solid #c9cbe0;
    border-top: 7px solid transparent;
    border-bottom: 7px solid transparent;
    transform: translate(-50%, -50%) rotate(-35deg);
  }
  .skill-list { list-style: none; margin: 0; padding: 0; }
  .skill-list li { position: absolute; transform: translate(-50%, -50%); }
  .skill {
    width: 56px; height: 56px;
    border-radius: 50%;
    border: 4px solid var(--surface);
    box-shadow: var(--shadow);
    color: #fff;
    font: 700 15px/1 var(--font);
    cursor: pointer;
    transition: scale var(--fast) var(--ease-out), box-shadow var(--fast);
  }
  .skill:active { scale: 0.95; }
  .skill:hover, .skill[aria-pressed='true'] {
    scale: 1.12;
    box-shadow: 0 0 0 4px rgba(240, 80, 110, 0.25), var(--shadow);
  }
  .skill-card {
    position: absolute;
    top: 0; left: 0;
    width: min(440px, 100%);
    padding: 24px;
  }
  .skill-card h3 { font-size: 16px; margin-bottom: 12px; }
  .chips { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 8px; }
  .chips :global(li) {
    background: var(--bg);
    color: var(--heading);
    border-radius: 999px;
    padding: 2px 12px;
    font-size: 12px;
  }
  .note { margin: 12px 0 0; font-size: 12px; }

  @media (max-width: 767px) {
    .stage { height: auto; }
    .curve, .arrow { display: none; }
    .skill-card { position: static; width: 100%; margin-bottom: 24px; }
    .skill-list {
      display: flex; gap: 16px;
      overflow-x: auto;
      padding: 12px 4px 16px;
      scroll-snap-type: x mandatory;
    }
    .skill-list li { position: static; transform: none; flex: none; scroll-snap-align: start; }
  }
</style>

<script>
  type Skill = { name: string; items: string[]; note?: string };
  for (const stage of document.querySelectorAll<HTMLElement>('.stage[data-skills]')) {
    const skills: Skill[] = JSON.parse(stage.dataset.skills!);
    const buttons = stage.querySelectorAll<HTMLButtonElement>('.skill');
    const field = (name: string) => stage.querySelector<HTMLElement>(`[data-field="${name}"]`)!;

    const select = (i: number) => {
      const s = skills[i];
      field('name').textContent = s.name;
      field('items').replaceChildren(...s.items.map((i) => {
        const li = document.createElement('li');
        li.textContent = i;
        li.style.setProperty('--i', String(s.items.indexOf(i)));
        return li;
      }));
      field('note').textContent = s.note ?? '';
      field('note').hidden = !s.note;
      buttons.forEach((b, j) => b.setAttribute('aria-pressed', String(i === j)));
    };

    const canHover = matchMedia('(hover: hover)').matches;
    buttons.forEach((b, i) => {
      b.addEventListener('click', () => select(i));
      if (canHover) b.addEventListener('mouseenter', () => select(i));
    });
  }
</script>
