---
import content from '../data/content.json';
import SocialLinks from './SocialLinks.astro';
import { Picture } from 'astro:assets';
import syvamo from '../assets/projects/syvamo/syvamo-01.png';
import mintego from '../assets/projects/mintego/mintego-01.png';
import kuljekas from '../assets/projects/kuljekas/kuljekas-01.jpg';
const { person } = content;
const base = import.meta.env.BASE_URL;
---
<section id="home" class="section hero">
  <div class="container hero-grid">
    <div class="hero-text">
      <span class="eyebrow hello"><span>Tere,</span> mina olen</span>
      <h1>{person.name}</h1>
      <p class="tagline">{person.tagline}</p>
      <p>{person.intro}</p>
      <div class="actions">
        <a class="btn btn-primary" href="#contact">Võta ühendust</a>
        {person.cv && <a class="btn btn-outline" href={`${base}${person.cv}`} download>Laadi CV</a>}
      </div>
    </div>

    <!-- Real project screenshots instead of a photo; layers drift apart on scroll. -->
    <div class="hero-art" aria-hidden="true">
      <div class="glow"></div>
      <Picture class="layer back" src={kuljekas} alt="" formats={['avif', 'webp']} widths={[400, 800]} sizes="360px" />
      <Picture class="layer mid" src={mintego} alt="" formats={['avif', 'webp']} widths={[400, 800]} sizes="360px" />
      <Picture class="layer front" src={syvamo} alt="" formats={['avif', 'webp']} widths={[480, 960]} sizes="440px" loading="eager" />
    </div>

    {content.social.length > 0 && <div class="hero-social"><SocialLinks vertical /></div>}
  </div>
</section>

<style>
  .hero { padding-top: 96px; }
  .hero-grid {
    display: grid;
    grid-template-columns: 1fr 1fr auto;
    align-items: center;
    gap: 32px;
    min-height: 520px;
  }
  .hello { font-size: 12px; color: var(--heading); }
  .hello span { color: var(--accent); }
  h1 {
    font-size: clamp(26px, 6.5vw, 48px);
    overflow-wrap: anywhere;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.02em;
    margin-bottom: 12px;
  }
  .hero-text p { max-width: 440px; margin: 0 0 32px; }
  .hero-text .tagline { color: var(--accent); font-weight: 600; margin-bottom: 16px; }
  .actions { display: flex; gap: 16px; flex-wrap: wrap; }

  /* Load-in: short, soft, staggered. */
  .hero-text > * { animation: rise 0.7s var(--ease-out) both; }
  .hero-text > :nth-child(2) { animation-delay: 60ms; }
  .hero-text > :nth-child(3) { animation-delay: 120ms; }
  .hero-text > :nth-child(4) { animation-delay: 180ms; }
  .hero-text > :nth-child(5) { animation-delay: 240ms; }

  .hero-art { position: relative; aspect-ratio: 5 / 4; width: 100%; max-width: 520px; justify-self: center; }
  .glow {
    position: absolute;
    inset: 10% 5%;
    background: radial-gradient(closest-side, rgba(91, 63, 209, 0.22), rgba(240, 80, 110, 0.12) 55%, transparent);
    filter: blur(30px);
  }
  .hero-art :global(.layer) {
    position: absolute;
    width: 68%;
    height: auto;
    border-radius: 10px;
    box-shadow: 0 1px 2px rgba(27, 31, 59, 0.08), 0 24px 60px -12px rgba(27, 31, 59, 0.28);
    animation: layer-in 0.9s var(--ease-out) both;
  }
  .hero-art :global(.back) { top: 0; right: 0; rotate: 4deg; animation-delay: 120ms; }
  .hero-art :global(.mid) { top: 22%; left: 0; rotate: -3deg; animation-delay: 220ms; }
  .hero-art :global(.front) { bottom: 0; right: 10%; width: 74%; animation-delay: 320ms; }

  @keyframes rise { from { opacity: 0; translate: 0 12px; filter: blur(6px); } }
  @keyframes layer-in { from { opacity: 0; scale: 0.94; filter: blur(8px); } }

  /* Scroll-linked parallax where the browser supports scroll timelines. */
  @supports (animation-timeline: scroll()) {
    .hero-art :global(.layer) {
      animation: layer-in 0.9s var(--ease-out) both, drift linear both;
      animation-timeline: auto, scroll(root);
      animation-range: normal, 0 90vh;
    }
    .hero-art :global(.back) { --drift: -60px; animation-delay: 120ms, 0s; }
    .hero-art :global(.mid) { --drift: -20px; animation-delay: 220ms, 0s; }
    .hero-art :global(.front) { --drift: 40px; animation-delay: 320ms, 0s; }
    @keyframes drift { to { translate: 0 var(--drift); } }
  }

  @media (max-width: 767px) {
    .hero { padding-top: 56px; }
    .hero-grid { grid-template-columns: 1fr; text-align: center; min-height: 0; }
    .hero-text p { margin-inline: auto; }
    .actions { justify-content: center; }
    .hero-art { order: -1; max-width: 320px; margin-inline: auto; }
    .hero-social { justify-self: center; }
    .hero-social :global(.social.vertical) { flex-direction: row; padding: 8px 12px; }
  }
</style>
