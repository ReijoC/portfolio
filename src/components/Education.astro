---
import content from '../data/content.json';
import Decorations from './Decorations.astro';
---
<section id="education" class="section">
  <Decorations set="b" />
  <div class="container">
    <div class="section-head">
      <span class="eyebrow">Kvalifikatsioon</span>
      <h2 class="section-title">Haridus</h2>
    </div>
    <ol class="timeline">
      {content.education.map((e) => (
        <li>
          <span class="dot" aria-hidden="true"></span>
          <article class="card item">
            <span class="eyebrow">{e.school} · {e.years}</span>
            <h3>{e.degree}</h3>
            {e.text && <p>{e.text}</p>}
          </article>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .timeline {
    position: relative;
    list-style: none;
    margin: 0 auto;
    padding: 0 0 0 72px;
    max-width: 820px;
    display: grid;
    gap: 28px;
  }
  /* Curved spine, as in the mock-up. */
  .timeline::before {
    content: '';
    position: absolute;
    left: 0; top: 0; bottom: 0;
    width: 60px;
    border: 2px dashed #d9dbea;
    border-color: transparent transparent transparent #d9dbea;
    border-radius: 50%;
  }
  li { position: relative; }
  li:nth-child(2) { margin-left: -24px; }
  .dot {
    position: absolute;
    left: -40px; top: 32px;
    width: 14px; height: 14px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 0 5px rgba(240, 80, 110, 0.18);
  }
  li:nth-child(2) .dot { left: -16px; }
  .item { padding: 24px 28px; }
  h3 { font-size: 16px; font-weight: 600; margin-bottom: 4px; }
  p { margin: 0; }

  @media (max-width: 767px) {
    .timeline { padding-left: 28px; }
    .timeline::before { width: 0; border-radius: 0; left: 6px; }
    li:nth-child(2) { margin-left: 0; }
    .dot, li:nth-child(2) .dot { left: -28px; }
  }
</style>
