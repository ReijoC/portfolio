---
// Small inline SVG icon set: line icons for services, simple glyphs for social networks.
interface Props { name: string; size?: number }
const { name, size = 24 } = Astro.props;

const line: Record<string, string> = {
  layout: '<rect x="3" y="4" width="18" height="16" rx="2"/><path d="M3 9h18M9 9v11"/>',
  pen: '<path d="M4 20l4-1 11-11-3-3L5 16l-1 4z"/><path d="M14 6l3 3"/>',
  star: '<path d="M12 3l2.6 5.6 6 .7-4.5 4.1 1.2 6L12 16.4 6.7 19.4l1.2-6L3.4 9.3l6-.7z"/>',
  phone: '<rect x="7" y="2.5" width="10" height="19" rx="2"/><path d="M11 18.5h2"/>',
  play: '<circle cx="12" cy="12" r="9"/><path d="M10 8.5l5 3.5-5 3.5z"/>',
  code: '<path d="M8 7l-5 5 5 5M16 7l5 5-5 5M14 4l-4 16"/>',
  chat: '<path d="M4 5h16v11H9l-5 4z"/>',
  arrowLeft: '<path d="M15 5l-7 7 7 7"/>',
  arrowRight: '<path d="M9 5l7 7-7 7"/>',
  copy: '<rect x="8" y="8" width="12" height="12" rx="2"/><path d="M16 8V5a1 1 0 00-1-1H5a1 1 0 00-1 1v10a1 1 0 001 1h3"/>',
};

const social: Record<string, { color: string; svg: string }> = {
  dribbble: { color: '#ea4c89', svg: '<circle cx="12" cy="12" r="8" fill="none" stroke="#fff" stroke-width="1.6"/><path d="M5 9c5 1 10 0 13-3M6 17c3-5 8-6 13-5M9 4.5c3 4 5 9 6 15" fill="none" stroke="#fff" stroke-width="1.4"/>' },
  behance: { color: '#1769ff', svg: '<text x="12" y="16" text-anchor="middle" font-family="Arial, sans-serif" font-weight="700" font-size="10" fill="#fff">Bē</text>' },
  x: { color: '#111111', svg: '<path d="M7 6.5l10 11M17 6.5l-10 11" stroke="#fff" stroke-width="2" stroke-linecap="round"/>' },
  github: { color: '#181717', svg: '<path d="M9.5 18c-3 .9-3-1.5-4-1.8M14.5 19.5v-2.6c0-.8.1-1.4-.4-1.9 2.2-.2 4.4-1.1 4.4-4.9 0-1-.4-1.9-1-2.6.1-.3.4-1.3-.1-2.6 0 0-.8-.3-2.7 1a9 9 0 00-4.8 0C8 4.8 7.2 5.1 7.2 5.1c-.5 1.3-.2 2.3-.1 2.6-.6.7-1 1.6-1 2.6 0 3.8 2.2 4.7 4.4 4.9-.4.4-.5 1-.4 1.6v2.7" fill="none" stroke="#fff" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>' },
  linkedin: { color: '#0a66c2', svg: '<text x="12" y="16.5" text-anchor="middle" font-family="Arial, sans-serif" font-weight="700" font-size="11" fill="#fff">in</text>' },
};

const s = social[name];
---
{s ? (
  <svg width={size} height={size} viewBox="0 0 24 24" aria-hidden="true">
    <circle cx="12" cy="12" r="12" fill={s.color} />
    <Fragment set:html={s.svg} />
  </svg>
) : (
  <svg width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor"
    stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <Fragment set:html={line[name] ?? ''} />
  </svg>
)}
