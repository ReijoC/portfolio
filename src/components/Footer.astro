---
import content from '../data/content.json';
import SocialLinks from './SocialLinks.astro';
import Icon from './Icon.astro';
---
<footer class="footer">
  <div class="container inner">
    <SocialLinks />
    <nav aria-label="Main">
      <ul>
        {content.nav.map((n) => <li><a href={n.href}>{n.label}</a></li>)}
      </ul>
    </nav>
    <a class="chat" href={`mailto:${content.person.email}`}>
      <Icon name="chat" />
      <span class="sr-only">Send me a message</span>
    </a>
  </div>
  <p class="copyright">© {new Date().getFullYear()} {content.person.name}</p>
</footer>

<style>
  .footer { padding: 48px 0 24px; }
  .inner { display: flex; align-items: center; justify-content: space-between; gap: 24px; }
  ul { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 8px 32px; justify-content: center; }
  nav a { color: var(--heading); font-weight: 500; text-decoration: none; }
  nav a:hover { color: var(--accent); }
  .chat {
    width: 52px; height: 52px;
    border-radius: 50%;
    background: var(--accent);
    color: #fff;
    display: grid; place-items: center;
    box-shadow: var(--shadow-accent);
    transition: transform 0.2s;
  }
  .chat:hover { transform: translateY(-2px); }
  .copyright { text-align: center; font-size: 12px; margin: 32px 0 0; }
  @media (max-width: 767px) {
    .inner { flex-direction: column; }
  }
</style>
