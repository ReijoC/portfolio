---
import content from '../data/content.json';
import SocialLinks from './SocialLinks.astro';
---
<footer class="footer">
  <div class="container inner">
    {content.social.length > 0 && <SocialLinks />}
    <nav aria-label="Peamenüü">
      <ul>
        {content.nav.map((n) => <li><a href={n.href}>{n.label}</a></li>)}
      </ul>
    </nav>
  </div>
  <p class="copyright">© {new Date().getFullYear()} {content.person.name}</p>
</footer>

<style>
  .footer { padding: 48px 0 96px; }
  .inner { display: flex; align-items: center; justify-content: center; gap: 24px; }
  ul { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 8px 32px; justify-content: center; }
  nav a { color: var(--heading); font-weight: 500; text-decoration: none; }
  nav a:hover { color: var(--accent); }
  .copyright { text-align: center; font-size: 12px; margin: 32px 0 0; }
  @media (max-width: 767px) {
    .inner { flex-direction: column; }
  }
</style>
