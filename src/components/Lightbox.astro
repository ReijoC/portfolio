---
import Icon from './Icon.astro';
---
<dialog class="lightbox" aria-label="Pildi suurendus">
  <button type="button" class="lb-btn lb-close" aria-label="Sulge"><Icon name="close" /></button>
  <button type="button" class="lb-btn lb-prev" aria-label="Eelmine pilt"><Icon name="arrowLeft" /></button>
  <figure>
    <img alt="" />
    <figcaption><span class="lb-caption"></span> <span class="lb-count"></span></figcaption>
  </figure>
  <button type="button" class="lb-btn lb-next" aria-label="Järgmine pilt"><Icon name="arrowRight" /></button>
</dialog>

<style>
  .lightbox {
    width: 100vw; height: 100dvh;
    max-width: none; max-height: none;
    margin: 0; padding: 0;
    border: 0;
    background: transparent;
    color: #fff;
    overflow: hidden;
  }
  .lightbox[open] { display: grid; grid-template-columns: auto 1fr auto; align-items: center; animation: lb-in 0.25s ease; }
  .lightbox::backdrop { background: rgba(14, 16, 32, 0.92); backdrop-filter: blur(4px); }
  @keyframes lb-in { from { opacity: 0; } to { opacity: 1; } }
  figure {
    margin: 0;
    height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 56px 8px 16px;
    min-width: 0;
    touch-action: pan-y pinch-zoom;
  }
  img {
    max-width: 100%;
    max-height: calc(100dvh - 120px);
    object-fit: contain;
    border-radius: 6px;
    box-shadow: 0 30px 80px rgba(0, 0, 0, 0.5);
    transition: opacity 0.2s ease, transform 0.2s ease;
  }
  img.swap { opacity: 0; transform: scale(0.98); }
  figcaption { margin-top: 14px; font-size: 14px; text-align: center; color: rgba(255, 255, 255, 0.85); }
  .lb-count { opacity: 0.6; margin-left: 8px; }
  .lb-btn {
    width: 48px; height: 48px;
    margin: 0 16px;
    border-radius: 50%;
    border: 0;
    background: rgba(255, 255, 255, 0.12);
    color: #fff;
    display: grid; place-items: center;
    cursor: pointer;
    transition: background-color 0.2s, transform 0.2s;
  }
  .lb-btn:hover { background: var(--accent); transform: scale(1.06); }
  .lb-btn[hidden] { visibility: hidden; display: grid; }
  .lb-close { position: absolute; top: 16px; right: 0; z-index: 1; }
  @media (max-width: 767px) {
    .lightbox[open] { grid-template-columns: 1fr; }
    .lb-prev, .lb-next { position: absolute; bottom: 16px; margin: 0; }
    .lb-prev { left: 16px; }
    .lb-next { right: 16px; }
    figure { padding: 64px 0 80px; }
    img { border-radius: 0; max-height: calc(100dvh - 180px); }
  }
</style>

<script>
  type Item = { src: string; alt: string; caption: string };
  const dlg = document.querySelector<HTMLDialogElement>('dialog.lightbox')!;
  const img = dlg.querySelector('img')!;
  const caption = dlg.querySelector<HTMLElement>('.lb-caption')!;
  const count = dlg.querySelector<HTMLElement>('.lb-count')!;
  const prev = dlg.querySelector<HTMLButtonElement>('.lb-prev')!;
  const next = dlg.querySelector<HTMLButtonElement>('.lb-next')!;
  let items: Item[] = [];
  let index = 0;
  let opener: HTMLElement | null = null;

  const preload = (i: number) => { if (items[i]) new Image().src = items[i].src; };

  const show = (i: number, animate = true) => {
    index = (i + items.length) % items.length;
    const it = items[index];
    const apply = () => {
      img.src = it.src;
      img.alt = it.alt;
      caption.textContent = it.caption;
      count.textContent = items.length > 1 ? `${index + 1} / ${items.length}` : '';
      img.classList.remove('swap');
    };
    if (animate) { img.classList.add('swap'); setTimeout(apply, 150); } else apply();
    prev.hidden = next.hidden = items.length < 2;
    preload(index + 1);
    preload(index - 1);
  };

  window.openLightbox = (list: Item[], start: number, from?: HTMLElement) => {
    items = list;
    opener = from ?? null;
    show(start, false);
    dlg.showModal();
    document.documentElement.style.overflow = 'hidden';
  };

  dlg.addEventListener('close', () => {
    document.documentElement.style.overflow = '';
    opener?.focus();
  });
  dlg.querySelector('.lb-close')!.addEventListener('click', () => dlg.close());
  prev.addEventListener('click', () => show(index - 1));
  next.addEventListener('click', () => show(index + 1));
  dlg.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowLeft') show(index - 1);
    if (e.key === 'ArrowRight') show(index + 1);
  });
  // Click on the dark area (outside the image and buttons) closes.
  dlg.addEventListener('click', (e) => {
    const t = e.target as HTMLElement;
    if (t === dlg || t.tagName === 'FIGURE') dlg.close();
  });

  let startX = 0;
  let startY = 0;
  dlg.addEventListener('touchstart', (e) => { startX = e.touches[0].clientX; startY = e.touches[0].clientY; }, { passive: true });
  dlg.addEventListener('touchend', (e) => {
    const dx = e.changedTouches[0].clientX - startX;
    const dy = e.changedTouches[0].clientY - startY;
    if (Math.abs(dx) > 50 && Math.abs(dx) > Math.abs(dy)) show(index + (dx < 0 ? 1 : -1));
  }, { passive: true });
</script>
