---
interface Item { org: string; title: string; years: string; text?: string; items?: string[] }
interface Props { id: string; eyebrow: string; title: string; items: Item[] }
const { id, eyebrow, title, items } = Astro.props;
---
<section id={id} class="section">
  <div class="container">
    <div class="section-head">
      <span class="eyebrow">{eyebrow}</span>
      <h2 class="section-title">{title}</h2>
    </div>
    <ol class="timeline">
      {items.map((e) => (
        <li>
          <span class="dot" aria-hidden="true"></span>
          <article class="card spot item">
            <span class="eyebrow">{e.org} · {e.years}</span>
            <h3>{e.title}</h3>
            {e.text && <p>{e.text}</p>}
            {e.items && e.items.length > 0 && (
              <ul>{e.items.map((i) => <li>{i}</li>)}</ul>
            )}
          </article>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .timeline {
    position: relative;
    list-style: none;
    margin: 0 auto;
    padding: 0 0 0 72px;
    max-width: 820px;
    display: grid;
    gap: 28px;
  }
  /* Curved spine, as in the mock-up. */
  .timeline::before {
    content: '';
    position: absolute;
    left: 0; top: 0; bottom: 0;
    width: 60px;
    border: 2px dashed #d9dbea;
    border-color: transparent transparent transparent #d9dbea;
    border-radius: 50%;
  }
  .timeline > li { position: relative; }
  .timeline > li:nth-child(2) { margin-left: -24px; }
  .dot {
    position: absolute;
    left: -40px; top: 32px;
    width: 14px; height: 14px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 0 5px rgba(240, 80, 110, 0.18);
  }
  .timeline > li:nth-child(2) .dot { left: -16px; }
  .item { padding: 24px 28px; }
  h3 { font-size: 16px; font-weight: 600; margin-bottom: 4px; }
  p { margin: 0; }
  ul { margin: 8px 0 0; padding-left: 18px; }
  ul li::marker { color: var(--accent); }

  @media (max-width: 767px) {
    .timeline { padding-left: 28px; }
    .timeline::before { width: 0; border-radius: 0; left: 6px; }
    .timeline > li:nth-child(2) { margin-left: 0; }
    .dot, .timeline > li:nth-child(2) .dot { left: -28px; }
  }
</style>
